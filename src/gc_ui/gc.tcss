.panel {
    background: $surface;
    border: panel $secondary;
    border-title-align: center;
}

#left {
    width: 45%;
}

#status_panel {
    height: 55%;
    margin-bottom: 1
}

#mission_select_panel {
    width: 2fr;
    padding-top: 3;
}

#mission_selector {
    width: 80%;
}

#start_mission_button {
    margin-top: 1;
    width: 40%;
}

#cancel_mission_button {
    margin-top: 1;
    width: 40%;
    display: None;
}

# ################################
#      Mission Started Class     #
# ################################

.mission_started #start_mission_button{
    display: None;
}

.mission_started #cancel_mission_button {
    display: block;
}

.mission_started #mission_selector {
    color: red;
}

.mission_started #mission_select_panel {
    background: $surface-darken-2;
}